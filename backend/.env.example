MONGO_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net"
DB_NAME="hpl"
# Exact frontend URLs (comma separated, no trailing slash)
CORS_ORIGINS="https://www.hpldigi.in,https://hpldigi.in,http://localhost:3000"
# Optional: allow Cloudflare preview URLs, e.g. ^https://.*\.pages\.dev$
CORS_ORIGIN_REGEX=
SITE_URL=https://www.hpldigi.in
APP_TZ=Asia/Kolkata
# Long random value, e.g. run: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=PUT_A_LONG_RANDOM_SECRET_HERE
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@2024
# Production over HTTPS:
COOKIE_SECURE=true
# api.hpldigi.in + www.hpldigi.in = same site -> lax. Different domains (pages.dev + onrender.com) -> none
COOKIE_SAMESITE=lax
